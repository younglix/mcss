DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production
MCSS_DATABASE_URL=postgres://mcss:mcss@localhost:5432/mcss_erp
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=
# Production only. Comma-separated full origins, e.g. http://169.58.243.48
CSRF_TRUSTED_ORIGINS=
# Production only. false ONLY while the site runs on a bare IP over plain
# HTTP (no domain/certificate yet); true (the default) once HTTPS is live.
MCSS_HTTPS=true

# File storage: AWS S3 or any S3-compatible provider. For Cloudflare R2:
#   AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   AWS_S3_REGION_NAME=auto
#   AWS_S3_CUSTOM_DOMAIN=pub-xxxxxxxx.r2.dev   (the bucket's public URL host)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
