## 5. RBAC — the access-control core

The spec is explicit: **don't gate on role names, gate on permission strings.** A role is just a named bundle of permissions. A user has one or more roles; their effective permission set is the union.

### 5.1 Data model

```python
# apps/rbac/models.py
from django.db import models
from common.models import BaseModel

class Permission(BaseModel):
    # e.g. "results.approve", "fees.collect", "students.delete"
    code = models.CharField(max_length=100, unique=True)
    module = models.CharField(max_length=50)     # "results", "fees", "students"
    action = models.CharField(max_length=50)     # "approve", "collect", "delete"
    description = models.CharField(max_length=255, blank=True)

class Role(BaseModel):
    name = models.CharField(max_length=100, unique=True)   # "Principal", "Teacher"
    slug = models.SlugField(unique=True)                   # "principal"
    description = models.CharField(max_length=255, blank=True)
    is_system = models.BooleanField(default=False)  # system roles can't be deleted

class RolePermission(BaseModel):
    role = models.ForeignKey(Role, on_delete=models.CASCADE, related_name="role_permissions")
    permission = models.ForeignKey(Permission, on_delete=models.CASCADE)

    class Meta:
        unique_together = ("role", "permission")

class UserRole(BaseModel):
    user = models.ForeignKey("accounts.User", on_delete=models.CASCADE, related_name="user_roles")
    role = models.ForeignKey(Role, on_delete=models.CASCADE)

    class Meta:
        unique_together = ("user", "role")
```

This gives the exact tables the spec calls for: `users`, `roles`, `permissions`, `role_permissions` (plus `user_roles` for many-roles-per-user).

### 5.2 The permission registry

Keep the master list of permission strings in code so it's version-controlled and seed-able. Grouped by module:

```python
# apps/rbac/constants.py
PERMISSIONS = {
    "students":   ["view", "create", "edit", "delete", "export"],
    "attendance": ["view", "create", "edit"],
    "results":    ["view", "enter", "edit", "approve", "publish"],
    "fees":       ["view", "create", "collect", "refund", "waive"],
    "staff":      ["view", "create", "edit", "delete"],
    "payroll":    ["view", "run", "approve"],
    "config":     ["view", "edit"],          # school configuration
    "settings":   ["view", "edit"],          # system settings
    "roles":      ["view", "create", "edit", "delete", "assign"],
    "users":      ["view", "create", "edit", "delete", "reset_password"],
    "audit":      ["view"],
    "dashboard":  ["view"],
    # ...expands per module as later phases land
}
# flattened → "students.view", "results.approve", etc.
```

A management command (`seed_rbac`) turns this into `Permission` rows and wires up the default roles from the spec's Section 33 table.

### 5.3 Enforcement in DRF

One reusable permission class reads the effective set:

```python
# apps/rbac/permissions.py
from rest_framework.permissions import BasePermission

def get_effective_permissions(user) -> set[str]:
    if user.is_superadmin:
        return {"*"}   # wildcard: everything
    # cached in Redis, keyed by (user_id, perms_version)
    return set(
        RolePermission.objects
        .filter(role__userrole__user=user)
        .values_list("permission__code", flat=True)
    )

class HasPermission(BasePermission):
    """Usage: permission_classes = [HasPermission("students.view")]"""
    def __init__(self, code):
        self.code = code

    def has_permission(self, request, view):
        perms = get_effective_permissions(request.user)
        return "*" in perms or self.code in perms
```

```python
# example usage in a viewset
class StudentViewSet(ModelViewSet):
    def get_permissions(self):
        mapping = {
            "list": "students.view", "retrieve": "students.view",
            "create": "students.create", "update": "students.edit",
            "destroy": "students.delete",
        }
        return [HasPermission(mapping[self.action])]
```

