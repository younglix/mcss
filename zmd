## 6. School configuration

The "what the school is" tables. These are the objects the rest of the ERP references (a student belongs to a class arm within a session, etc.). Managed by Super Admin under `config.*`.

```python
# apps/configuration/models.py
from common.models import BaseModel
from django.db import models

class SchoolProfile(BaseModel):        # singleton row
    name = models.CharField(max_length=200)
    logo = models.URLField(blank=True)
    address = models.TextField(blank=True)
    phone = models.CharField(max_length=20, blank=True)
    email = models.EmailField(blank=True)
    motto = models.CharField(max_length=200, blank=True)

class AcademicSession(BaseModel):      # e.g. 2026/2027
    name = models.CharField(max_length=20, unique=True)
    start_date = models.DateField()
    end_date = models.DateField()
    is_current = models.BooleanField(default=False)

class Term(BaseModel):                 # First/Second/Third within a session
    session = models.ForeignKey(AcademicSession, on_delete=models.CASCADE, related_name="terms")
    name = models.CharField(max_length=30)
    start_date = models.DateField()
    end_date = models.DateField()
    is_current = models.BooleanField(default=False)

class Department(BaseModel):
    name = models.CharField(max_length=100, unique=True)

class SchoolClass(BaseModel):          # JSS 1, Primary 5, SS 2 ...
    name = models.CharField(max_length=50, unique=True)
    level_order = models.PositiveIntegerField()   # drives promotion ordering

class ClassArm(BaseModel):             # JSS 1A, JSS 1B ...
    school_class = models.ForeignKey(SchoolClass, on_delete=models.CASCADE, related_name="arms")
    name = models.CharField(max_length=10)         # "A", "B"

    class Meta:
        unique_together = ("school_class", "name")

class GradeScale(BaseModel):           # grading system config
    name = models.CharField(max_length=50)         # "A1", "B2"...
    min_score = models.PositiveIntegerField()
    max_score = models.PositiveIntegerField()
    remark = models.CharField(max_length=50)       # "Excellent"
    grade_point = models.DecimalField(max_digits=3, decimal_places=1, null=True)

class FeeCategory(BaseModel):          # Tuition, ICT, Development...
    name = models.CharField(max_length=100, unique=True)
    is_recurring = models.BooleanField(default=True)
```

**Key rule:** exactly one `AcademicSession` and one `Term` can be `is_current=True` at a time — enforce with a `services.set_current_session()` that flips the others in a transaction. Almost every later module reads "current session/term," so this must be reliable.

